Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Humanoid
      Description Source: Topic
      Description Topic:
        Value: /humanoid/robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      TF Prefix: ""
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Quadruped
      Description Source: Topic
      Description Topic:
        Value: /quadruped/robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      TF Prefix: ""
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: PhysicsMarkers
      Topic:
        Value: /physics_markers
      Value: true
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Name: Current View
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  X: 0
  Y: 0
