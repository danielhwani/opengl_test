<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsl"?>
<package format="3">
  <name>humanoid_sim</name>
  <version>0.0.1</version>
  <description>
    Republishes the walking/trot animation from the computer_graphics OpenGL
    demo (humanoid_test.c / humanoid_loader_test.c) as ROS2 joint_states + TF
    for RViz2 visualization. Uses humanoid.urdf / quadruped.urdf generated by
    gen_humanoid_assets.exe.
  </description>
  <maintainer email="noreply@example.com">computer_graphics</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
